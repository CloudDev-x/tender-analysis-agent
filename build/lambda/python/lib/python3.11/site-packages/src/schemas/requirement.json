{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenderRequirement",
  "type": "object",
  "required": [
    "requirement_id",
    "category",
    "description",
    "mandatory",
    "evidence_required",
    "source",
    "confidence"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3,}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "TECHNICAL",
        "COMMERCIAL",
        "FINANCIAL",
        "LEGAL",
        "REGULATORY",
        "COMPLIANCE",
        "ADMINISTRATIVE",
        "EXPERIENCE",
        "PERSONNEL",
        "DOCUMENTATION",
        "DELIVERABLE",
        "DEADLINE",
        "EVALUATION",
        "OTHER"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "mandatory": {
      "type": "boolean"
    },
    "evidence_required": {
      "type": "boolean"
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["page", "section", "text"],
      "properties": {
        "page": {
          "type": ["integer", "string"],
          "description": "Page number or 'unknown' if not determinable"
        },
        "section": {
          "type": ["string", "null"]
        },
        "text": {
          "type": "string",
          "description": "Verbatim source text from tender"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": false
}
