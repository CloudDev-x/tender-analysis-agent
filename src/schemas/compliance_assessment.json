{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComplianceAssessment",
  "type": "object",
  "required": [
    "requirement_id",
    "status",
    "evidence_source",
    "reason",
    "confidence",
    "human_review_required"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "MET",
        "PARTIAL",
        "GAP",
        "EXPIRED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "dynamo_record_pk": { "type": "string" },
        "dynamo_record_sk": { "type": "string" },
        "kb_chunk_id": { "type": ["string", "null"] },
        "kb_score": { "type": ["number", "null"] },
        "s3_evidence_key": { "type": ["string", "null"] }
      }
    },
    "evidence_source": {
      "type": "string",
      "enum": ["DYNAMODB", "KNOWLEDGE_BASE", "BOTH", "NONE"]
    },
    "reason": {
      "type": "string",
      "minLength": 5
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "human_review_required": {
      "type": "boolean"
    },
    "review_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
